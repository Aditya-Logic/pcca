# ============================================================
# PCCA Portal — environment
#
# Copy to .env and fill in. NEVER commit .env.
# Generate the secrets with:  cd backend && npm run keys:generate
# ============================================================

NODE_ENV=development
PORT=4000

# ---------- PostgreSQL ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=pcca_portal
PGUSER=pcca_app
PGPASSWORD=replace-me
PGSSL=false

# ---------- Auth secrets ----------
# Minimum 32 characters each, and they MUST differ from each other.
# The app refuses to start with placeholder values.
JWT_ACCESS_SECRET=replace-me-run-npm-run-keys-generate
JWT_REFRESH_SECRET=replace-me-run-npm-run-keys-generate-again
ACCESS_TTL_MIN=15
REFRESH_TTL_HOURS=8

# ---------- Where the browser app is served ----------
PUBLIC_ORIGIN=http://localhost:8080
# COOKIE_DOMAIN=.mha.gov.in       # production only

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---------- Optional integrations ----------
# Absent in demo. Required in production.
# SMTP_URL=smtp://user:pass@mail.gov.in:587
# SMS_GATEWAY_URL=https://sms.gov.in/api/send
# SMS_GATEWAY_KEY=
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ---------- Demo mode ----------
# true  -> seeds known demo accounts, returns the OTP in the API response
# false -> production behaviour
# The app REFUSES to start with DEMO_MODE=true and NODE_ENV=production.
DEMO_MODE=true
